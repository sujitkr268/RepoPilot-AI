# =================================================================
# RepoPilot AI - Environment Configuration
# =================================================================

PROJECT_NAME="RepoPilot AI"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Session
SECRET_KEY="change-me-to-a-secure-random-32-character-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: async sqlite (zero configuration local setup)
# For PostgreSQL with pgvector: postgresql+asyncpg://repopilot:repopilot_password@localhost:5432/repopilot_db
DATABASE_URL="sqlite+aiosqlite:///./repopilot.db"

# GitHub OAuth & REST API
# Register an OAuth app on GitHub Developer Settings with redirect URL: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/auth/callback"
# Optional GitHub personal access token for higher unauthenticated rate limits:
GITHUB_DEFAULT_TOKEN=""

# AI & LLM Provider Configuration
# Supported providers: mock, openai, anthropic, gemini, groq, ollama
# Default "mock" allows full platform functionality and deterministic evaluation without paid API keys.
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_TEMPERATURE=0.2

# Isolated Sandbox Testing Policy
SANDBOX_TIMEOUT_SECONDS=45
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_ALLOW_NETWORK=false
